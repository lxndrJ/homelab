# rclone remote name (must match a section in config/rclone.conf)
RCLONE_REMOTE=gdrive
# folder path inside the remote where the restic repository lives
RCLONE_PATH=homelab-backups

# host paths that get mounted into the backup container (adjust to your setup)
IMMICH_DATA=/srv/immich
NEXTCLOUD_DATA=/srv/nextcloud/data
NEXTCLOUD_CONFIG=/srv/nextcloud/config
VM_BACKUP_DIR=/srv/vzdump
VM_CONFIG_DIR=/srv/vm-backups
STAGING_DIR=/srv/backup-staging
RESTORE_DIR=/srv/restore

# database containers for pg_dumpall / mysqldump via docker exec
# leave *_DB_CONTAINER empty to skip that dump
IMMICH_DB_CONTAINER=immich_postgres
IMMICH_DB_TYPE=postgres
IMMICH_DB_USER=postgres
IMMICH_DB_PASSWORD=

NEXTCLOUD_DB_CONTAINER=nextcloud-db
NEXTCLOUD_DB_TYPE=mariadb
NEXTCLOUD_DB_USER=nextcloud
NEXTCLOUD_DB_PASSWORD=

# retention policy used by scripts/prune.sh
KEEP_DAILY=7
KEEP_WEEKLY=4
KEEP_MONTHLY=12
KEEP_YEARLY=3

TZ=Europe/Berlin
