# Template only. The real config/rclone.conf is generated by `rclone config`
# (or `rclone authorize` on headless hosts) and is gitignored - never commit it.
# Recommended scope: drive.file (token can only touch files created by rclone itself).
[gdrive]
type = drive
scope = drive.file
client_id = YOUR_CLIENT_ID.apps.googleusercontent.com
client_secret = YOUR_CLIENT_SECRET
token = {"access_token":"...","token_type":"Bearer","refresh_token":"...","expiry":"..."}
